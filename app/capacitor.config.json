{
  "appId": "com.featherandfield.game",
  "appName": "Feather & Field",
  "webDir": "www",
  "backgroundColor": "#557230",
  "ios": {
    "contentInset": "never",
    "scrollEnabled": false,
    "backgroundColor": "#557230",
    "preferredContentMode": "mobile"
  },
  "android": {
    "backgroundColor": "#557230"
  },
  "plugins": {
    "StatusBar": {
      "style": "DARK",
      "overlaysWebView": true
    },
    "SplashScreen": {
      "launchAutoHide": false,
      "launchFadeOutDuration": 250,
      "backgroundColor": "#5d8fb6",
      "showSpinner": false
    }
  }
}
